    "html",
    "mermaid",
    "live-reload",
    "dev-server",
    "static-server",
    "zero-build",
    "mkdocs-alternative",
    "sidebar"
  ],
  "license": "MIT",
  "author": "Kevin Weitgenant",
  "homepage": "https://github.com/kevin-weitgenant/htmlovermd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-weitgenant/htmlovermd.git"
  },
  "bugs": {
    "url": "https://github.com/kevin-weitgenant/htmlovermd/issues"
  },
  "type": "commonjs",
  "bin": {
    "htmlovermd": "./serve.js"
  },
  "main": "./serve.js",
  "files": [
    "serve.js",
    "reload.js",
    "manifest.js",
    "shell.js",
    "init.js",
    "client/"
  ],
  "engines": {
